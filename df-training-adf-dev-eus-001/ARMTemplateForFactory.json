{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-training-adf-dev-eus-001"
		},
		"ls_training_adf_retail_101_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_training_adf_retail_101'"
		},
		"ls_training_adf_retail_101_lake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_training_adf_retail_101_lake'"
		},
		"ls_training_adf_retail_101_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sttrainingadfdeveus001.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/product_csv_blob')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_training_adf_retail_101",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "retaildb project"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "products.csv",
						"container": "src"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_training_adf_retail_101')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_training_adf_retail_101')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Establish connection to ingest data from Azure Blob storage - retail db project",
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('ls_training_adf_retail_101_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_training_adf_retail_101_lake')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Establish connection to Data Lake for storing data from Blob storage for retail db project",
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_training_adf_retail_101_lake_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_training_adf_retail_101_lake_accountKey')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}