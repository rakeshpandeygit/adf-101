{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-training-adf-dev-eus-001"
		},
		"ls_training_adf_retail_101_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_training_adf_retail_101'"
		},
		"ls_training_adf_retail_101_lake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_training_adf_retail_101_lake'"
		},
		"ls_training_adf_retail_101_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sttrainingadfdeveus001.dfs.core.windows.net/"
		},
		"tr_products_copy_on_arrival_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/18f82c1d-5f8a-45a4-bbae-460a3807decb/resourceGroups/rg-training-adf-dev-eus-001/providers/Microsoft.Storage/storageAccounts/sttrainingadfdeveus002"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-training-adf-dev-eus-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_training_adf_retail_101_connectionString": {
						"value": "[parameters('ls_training_adf_retail_101_connectionString')]"
					},
					"ls_training_adf_retail_101_lake_accountKey": {
						"value": "[parameters('ls_training_adf_retail_101_lake_accountKey')]"
					},
					"ls_training_adf_retail_101_lake_properties_typeProperties_url": {
						"value": "[parameters('ls_training_adf_retail_101_lake_properties_typeProperties_url')]"
					},
					"tr_products_copy_on_arrival_properties_typeProperties_scope": {
						"value": "[parameters('tr_products_copy_on_arrival_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}