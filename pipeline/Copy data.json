{
	"name": "Copy data",
	"properties": {
		"description": "retaildb project pipeline to ingest file from blob to adls gen2",
		"activities": [
			{
				"name": "product_file_validation",
				"type": "Validation",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "product_csv_blob",
						"type": "DatasetReference"
					},
					"timeout": "0.00:03:00",
					"sleep": 30,
					"minimumSize": 1
				}
			},
			{
				"name": "fetch_product_file_metadata",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "product_file_validation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "product_csv_blob",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"columnCount",
						"size",
						"itemName"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "validate_metadata",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "fetch_product_file_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('fetch_product_file_metadata').output.columnCount,6)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "file_format_issue",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "file format issue - Num Columns not 6",
								"errorCode": "420"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "success_landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"metadata": [
											{
												"name": "_ingestion_date",
												"value": {
													"value": "@pipeline().TriggerTime",
													"type": "Expression"
												}
											},
											{
												"name": "_run_id",
												"value": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												}
											},
											{
												"name": "_file_name",
												"value": {
													"value": "@activity('fetch_product_file_metadata').output.itemName",
													"type": "Expression"
												}
											},
											{
												"name": "_file_size_bytes",
												"value": {
													"value": "@activity('fetch_product_file_metadata').output.size",
													"type": "Expression"
												}
											}
										]
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "product_csv_blob",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "product_csv_lake",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "remove_src_file",
							"description": "remove the source file upon successful ingestion to adls gen2",
							"type": "Delete",
							"dependsOn": [
								{
									"activity": "success_landing",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "product_csv_blob",
									"type": "DatasetReference"
								},
								"logStorageSettings": {
									"linkedServiceName": {
										"referenceName": "ls_training_adf_retail_101_lake",
										"type": "LinkedServiceReference"
									},
									"path": "retail-raw/retail_ingestion_logs"
								},
								"enableLogging": true,
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": false,
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "retaildb project"
		},
		"annotations": []
	}
}